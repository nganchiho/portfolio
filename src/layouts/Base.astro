---
import { profile } from "../data/site";
import "../styles/sections.css";

type NavLink = { href: string; label: string; match?: string };
interface Props {
  title?: string;
  description?: string;
  nav?: NavLink[];
  noindex?: boolean;
}
const workNav: NavLink[] = [
  { href: "/", label: "~/work", match: "/" },
  { href: "/#experience", label: "./experience" },
  { href: "/#projects", label: "./projects", match: "/projects" },
  { href: "/#contact", label: "./contact" },
];
const { title, description = profile.about, nav = workNav, noindex = false } = Astro.props;
const pageTitle = title ? `${title} · ${profile.name}` : `${profile.name} · ${profile.tagline}`;
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="window">
      <header class="bar">
        <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
        <span class="bar-title">{profile.handle}@{profile.host}: ~{path === "/" ? "" : path.replace(/\/$/, "")}</span>
      </header>
      <nav class="nav" aria-label="Main">
        {nav.map((l) => {
          const active = l.match && (l.match === "/" ? path === "/" : path.startsWith(l.match));
          return <a href={l.href} class={active ? "active" : ""}>{l.label}</a>;
        })}
      </nav>
      <main>
        <slot />
      </main>
      <footer class="foot">
        <span>© {new Date().getFullYear()} {profile.name}</span>
        <span class="muted">built with astro · hosted on vercel</span>
      </footer>
    </div>
  </body>
</html>

<style is:global>
  :root {
    --bg: #0d1117;
    --panel: #10161e;
    --line: #21262d;
    --text: #e6edf3;
    --muted: #8b949e;
    --dim: #6e7681;
    --green: #7ee787;
    --blue: #79c0ff;
    --amber: #e3b341;
    --pink: #ff7b72;
    --font: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: var(--font);
    font-size: 15px;
    line-height: 1.7;
    -webkit-font-smoothing: antialiased;
  }
  a { color: var(--blue); text-decoration: none; }
  a:hover { text-decoration: underline; text-underline-offset: 3px; }
  a:focus-visible { outline: 2px solid var(--green); outline-offset: 2px; }
  ::selection { background: var(--green); color: var(--bg); }
  .muted { color: var(--muted); }
  .dim { color: var(--dim); }
  .prompt { color: var(--dim); }
  .prompt .user { color: var(--green); }
  .prompt .cmd { color: var(--text); }
  section { scroll-margin-top: 24px; margin: 0 0 56px; }
  h1, h2, h3 { font-weight: 500; margin: 0; line-height: 1.3; }
  ul { margin: 0; padding: 0; list-style: none; }
  .tag {
    display: inline-block;
    font-size: 12px;
    color: var(--amber);
    border: 1px solid #3d3420;
    padding: 0 8px;
    margin: 0 6px 6px 0;
    border-radius: 3px;
  }
</style>

<style>
  .window {
    max-width: 860px;
    margin: 32px auto;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--panel);
    overflow: hidden;
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 10px 16px;
    border-bottom: 1px solid var(--line);
    background: #0b0f15;
    font-size: 12px;
    color: var(--dim);
  }
  .dots { display: flex; gap: 7px; }
  .dots i { width: 11px; height: 11px; border-radius: 50%; background: #30363d; display: block; }
  .dots i:nth-child(1) { background: #ff5f57; }
  .dots i:nth-child(2) { background: #febc2e; }
  .dots i:nth-child(3) { background: #28c840; }
  .bar-title { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .nav {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 20px;
    padding: 12px 28px;
    border-bottom: 1px dashed var(--line);
    font-size: 13px;
  }
  .nav a { color: var(--muted); }
  .nav a:hover, .nav a.active { color: var(--green); text-decoration: none; }
  main { padding: 36px 28px 8px; }
  .foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px;
    padding: 16px 28px;
    border-top: 1px solid var(--line);
    font-size: 12px;
    color: var(--dim);
  }
  @media (max-width: 640px) {
    body { font-size: 14px; }
    .window { margin: 0; border: 0; border-radius: 0; min-height: 100vh; }
    main { padding: 28px 16px 8px; }
    .nav, .foot { padding-left: 16px; padding-right: 16px; }
  }
</style>
